<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Biblioteca d'àudio: dispositius, reproductors, enregistradors i DSP.
    NAudio.Wasapi (MIT): accés a WASAPI (dispositius, reproducció i captura).
  -->
  <PropertyGroup>
    <RootNamespace>OnaBages.Audio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- LAME 3.100 x64 (LGPL, enllaç dinàmic): vegeu native/LLEGEIX-ME.md -->
  <ItemGroup>
    <None Include="native\libmp3lame.dll" Link="libmp3lame.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native\COPYING-LGPL-2.0.txt" Link="LAME-COPYING-LGPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
